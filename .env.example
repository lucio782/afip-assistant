# ============================================================
# ARCA Assistant — variables de entorno (todas opcionales)
# Copiá este archivo a .env y ajustá los valores.
# ============================================================

# --- App ---
APP_NAME=ARCA Assistant
APP_VERSION=2.1.0
APP_URL=https://calculararca.duckdns.org
PORT=3000
HOST=0.0.0.0
BODY_LIMIT=1mb
AUTO_SAVE_MS=300000

# --- Seguridad ---
# Clave para firmar JWT (obligatoria en producción)
JWT_SECRET=cambiar-esta-clave
# Clave para acceder a /api/metrics (x-admin-key) y borrar reseñas
ADMIN_KEY=cambiar-esta-clave
VISITOR_COOKIE=vv
VISITOR_COOKIE_MAX_AGE=31536000

# --- Base de datos ---
# Vacía = SQLite local. Con valor = PostgreSQL (prod en Render)
DATABASE_URL=

# --- Cotizaciones (fuentes externas) ---
BLUELYTICS_URL=https://api.bluelytics.com.ar/v2/latest
ERAPI_URL=https://open.er-api.com/v6/latest/USD
COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin%2Cethereum%2Ctether%2Csolana&vs_currencies=ars%2Cusd
DOLARAPI_URL=https://dolarapi.com/v1/dolares
BINANCE_URL=https://api.binance.com/api/v3/ticker/price
BINANCE_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","USDTUSDT"]
EXCHANGE_TIMEOUT_MS=10000
EXCHANGE_CACHE_TTL_MS=60000

# --- Noticias (RSS) ---
NEWS_FEEDS_LOCAL=["https://news.google.com/rss/search?q=(d%C3%B3lar%20OR%20monotributo%20OR%20econom%C3%ADa%20OR%20AFIP%20OR%20ARCA)%20Argentina&hl=es-419&gl=AR&ceid=AR:es-419"]
NEWS_FEEDS_INTERNACIONAL=["https://news.google.com/rss/search?q=mercados%20mundiales%20OR%20wall%20street&hl=es-419&gl=US&ceid=US:es-419","https://www.cnbc.com/id/100003114/device/rss/rss.html"]
NEWS_FEEDS_CRIPTO=["https://cointelegraph.com/rss"]
NEWS_CACHE_TTL_MS=600000
NEWS_TIMEOUT_MS=12000
NEWS_PER_CATEGORY=12
NEWS_USER_AGENT=Mozilla/5.0 (compatible; ARCA-Assistant/1.0)

# --- Alertas ---
DOLAR_ALERT_THRESHOLD=1500
ALERT_FETCH_TIMEOUT_MS=5000

# --- Reseñas ---
REVIEWS_DEFAULT_LIMIT=50
REVIEWS_MIN_COMMENT=3
REVIEWS_MAX_COMMENT=500

# --- MercadoPago (opcional: sin token = modo simulado) ---
MP_ACCESS_TOKEN=
